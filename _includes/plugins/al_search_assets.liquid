{% comment %}
  Parse-safe wrapper for al_search custom tag.
  Kept in an include so templates without the plugin can still render.
  Local override: fixes the lowercase "email" title in the search palette.
{% endcomment %}
{% al_search_assets %}
<script>
  (function () {
    var ninja = document.querySelector('ninja-keys');
    if (ninja && ninja.data && Array.isArray(ninja.data)) {
      ninja.data = ninja.data.map(function (item) {
        if (item && item.title === 'email') {
          item.title = 'Email';
        }
        if (item && item.title === 'Custom_social') {
          item.title = 'CSDN';
        }
        return item;
      });
    }
  })();
</script>
<script>
  // jekyll-socials renders the custom_social logo as an icon-font class, so
  // image URLs end up as an empty <i class="https://...">. Replace it with a
  // real <img> using the URL carried in the class attribute.
  (function () {
    var csdnIcon = document.querySelector('a[title="CSDN"] i');
    if (csdnIcon && csdnIcon.className && csdnIcon.className.indexOf('http') === 0) {
      var img = document.createElement('img');
      img.src = csdnIcon.className;
      img.alt = 'CSDN';
      img.style.height = '1em';
      img.style.width = 'auto';
      csdnIcon.replaceWith(img);
    }
  })();
</script>
